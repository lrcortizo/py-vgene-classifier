# ═══════════════════════════════════════════════════════════════
# V-Gene Classifier v2.0.0 - Git Ignore Configuration
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Python
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
env/
venv/
ENV/
.venv/

# ───────────────────────────────────────────────────────────────
# Data - Genomes and large sequence files
# ───────────────────────────────────────────────────────────────
# Genomes (very large, >1GB each)
data/genomes/

# IMGT/NCBI references (manual download required)
data/reference/imgt_*/
data/reference/ncbi_*/

# FASTA/FASTQ files (general exclusion)
*.fasta
*.fastq
*.fq
*.fa
*.fna

# EXCEPTIONS: Keep essential small files
!data/raw/positive/*.fasta
!data/background/*.fasta
!data/background_extended/*.fasta

# ───────────────────────────────────────────────────────────────
# Trained models
# ───────────────────────────────────────────────────────────────
# Ignore all models (large files, ~33MB each)
models/*.pt
models/*.pth

# EXCEPTION: Keep final v2.0.0 model
!models/v2_hybrid/
models/v2_hybrid/*.pt
!models/v2_hybrid/best_model.pt

# ───────────────────────────────────────────────────────────────
# Results - Large intermediate files
# ───────────────────────────────────────────────────────────────
# TBLASTN outputs (can be very large)
results/*/tblastn_results.txt

# Unclassified candidates (large)
results/*/candidates.fasta

# Temporary BLAST databases
*_db.*
*.nhr
*.nin
*.nsq
*.nsd
*.nsi
*.nog

# Multiple sequence alignments (very large)
results/*/phylogenetic*/combined_sequences.fasta
results/*/phylogenetic*/alignment.fasta

# Intermediate BLAST results
results/*/validation*/blast_results.txt

# EXCEPTIONS: Keep final outputs
!results/mouse_identity60/
!results/bat/
!results/*/vgenes_predicted.fasta
!results/*/vgenes_predicted_predictions.csv
!results/*/*.png
!results/*/*.csv

# Keep validation reports
!results/*/validation*/validated.csv
!results/*/validation*/misclassified.csv
!results/*/validation*/no_match.csv

# Keep phylogenetic trees
!results/*/phylogenetic*/tree.nexus
!results/*/phylogenetic*/tree.newick

# ───────────────────────────────────────────────────────────────
# IDEs and Editors
# ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────
# Operating System
# ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ───────────────────────────────────────────────────────────────
# Temporary and Logs
# ───────────────────────────────────────────────────────────────
*.tmp
*.log
*.bak
*.swp
*~

# ───────────────────────────────────────────────────────────────
# Configuration and Personal Notes
# ───────────────────────────────────────────────────────────────
.env
.env.local

# Development notes (personal)
PROGRESS.md
TODO.md
notes/
scratch/

# Backups (created during cleanup)
../backups/

# ───────────────────────────────────────────────────────────────
# Jupyter (if added in the future)
# ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ───────────────────────────────────────────────────────────────
# Deprecated (obsolete files moved)
