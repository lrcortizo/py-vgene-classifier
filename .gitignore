# ═══════════════════════════════════════════════════════════════
# V-Gene Classifier v2.0.0 - Git Ignore Configuration
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Python
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
env/
venv/
ENV/
.venv/

# ───────────────────────────────────────────────────────────────
# Data - Genomes and large sequence files
# ───────────────────────────────────────────────────────────────
# Genomes (very large, >1GB each)
data/genomes/

# IMGT/NCBI references (manual download required)
data/reference/imgt_*/
data/reference/ncbi_*/

# FASTA/FASTQ files (general exclusion)
*.fasta
*.fastq
*.fq
*.fa
*.fna

# EXCEPTIONS: Keep essential small files
!data/raw/positive/*.fasta
!data/background/*.fasta
!data/background_extended/*.fasta

# ───────────────────────────────────────────────────────────────
# Trained models
# ───────────────────────────────────────────────────────────────
# Ignore all model weights (large binary files, ~33MB each)
models/**/*.pt
models/**/*.pth
models/*.pt
models/*.pth

# ───────────────────────────────────────────────────────────────
# Results - Species output directories
# ───────────────────────────────────────────────────────────────
# Ignore ALL species result directories by default.
# New species are automatically ignored — add !exception below to track one.
results/*/

# Currently tracked species (final validation results committed)
!results/ferret_identity60/
!results/ferret_multispecies/
!results/human_identity60/
!results/human_multispecies_r2/
!results/mouse_identity60/

# Within tracked directories: skip large intermediate files
results/*/tblastn*.txt
results/*/candidates*.fasta
results/*/phylogenetic*/combined_sequences.fasta
results/*/phylogenetic*/alignment.fasta
results/*/validation*/blast_results.txt

# Temporary BLAST databases
*_db.*
*.nhr
*.nin
*.nsq
*.nsd
*.nsi
*.nog

# ───────────────────────────────────────────────────────────────
# IDEs and Editors
# ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
!CLAUDE.md

# ───────────────────────────────────────────────────────────────
# Operating System
# ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ───────────────────────────────────────────────────────────────
# Temporary and Logs
# ───────────────────────────────────────────────────────────────
*.tmp
*.log
*.bak
*.swp
*~

# ───────────────────────────────────────────────────────────────
# Configuration and Personal Notes
# ───────────────────────────────────────────────────────────────
.env
.env.local

# Development notes (personal)
PROGRESS.md
TODO.md
notes/
scratch/

# Backups (created during cleanup)
../backups/

# ───────────────────────────────────────────────────────────────
# Jupyter (if added in the future)
# ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ───────────────────────────────────────────────────────────────
# Claude Code
# ───────────────────────────────────────────────────────────────
.claude/

# ───────────────────────────────────────────────────────────────
# Experimental / intermediate processed data (not final pipeline)
# ───────────────────────────────────────────────────────────────
data/processed/
data/processed_hybrid/
data/processed_multispecies_r5/

# v2.2.0 processed data (not committed)
data/processed_v2.2/
data/background_v2.2/
data/raw/positive_v2.2/

# Model artifacts except weights (already covered by models/**/*.pt)
models/*/confusion_matrix.png
models/*/training_history.csv
models/*/training_history.png

